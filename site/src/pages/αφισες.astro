---
/** Ο τοίχος: μία αφίσα ανά vol., πλήρης ανάλυση, καμία περικοπή.
    Το vol.02 εκτίθεται ως αυτό που είναι: κενό. */
import Base from '../layouts/Base.astro';
import Fn from '../components/Fn.astro';
import Pic from '../components/Pic.astro';
import { media } from '../lib/archive';

const B = import.meta.env.BASE_URL.replace(/\/$/, '');
const walls = [
  {
    key: 'afisa-vol01-hires.jpg',
    vol: 'vol.01',
    date: 'Πέμπτη 29 Δεκεμβρίου 2016, «23:00 πάνω κάτω»',
    alt: 'Αφίσα ΒΛΑΞ vol.01: πορτοκαλί κολάζ με μωβ γραφομηχανή, τηλέφωνο με καντράν, αεροπλάνο, φύλλα, και τους δυο βλαξ σε φωτογραφίες, ο ένας με ψεύτικο μουστάκι, ο άλλος με αυτιά γαϊδάρου. «ΟΙ ΒΛΑΞ (dj set, live performance, κεράσματα, ξεφτιλίκια)».',
    caption: '«Πού; Στο καλύτερο καφέ της Γης (εκτός Γης ακόμα δεν έχουμε ψάξει).» Ψηφιακό πρωτότυπο δεν σώζεται, αυτό είναι το καλύτερο αντίτυπο που βρέθηκε.',
  },
  {
    key: 'afisa-vol02-hires.jpg',
    vol: 'vol.02',
    date: 'Παρασκευή 29 Δεκεμβρίου 2017, «11η βραδινή»',
    alt: 'Αφίσα ΒΛΑΞ vol.02: πορτοκαλί-κίτρινο ντεγκραντέ, «Ο Στέργιος Χατζηκυριακίδης και ο Αλέξανδρος Χαντζής είναι: οι βλάξ, μουσική . Χορός . Πλούσια δώρα . Ντροπιαστικές καταστάσεις». Δύο φανέλες μπάσκετ με αγιοβασιλιάτικα σκουφάκια: Bryant 24 λευκή, Αντετοκούνμπο 34 μαύρη.',
    caption: '«11η βραδινή, στον παλιό τον Βρίβο. Είσοδος: 143 €/άτομο με ζεστό κρασί.» Αγνοούμενη μία δεκαετία. Βρέθηκε σε τυπογραφική ανάλυση. Τι ήταν ο Βρίβος, δεν το ξέρουμε, πες μας.',
  },
  {
    key: 'afisa-propolisi-2018.jpg',
    vol: 'vol.03, προπώληση',
    date: 'αναγγέλλει «29 Δεκεμβρίου 2018» *',
    alt: 'Αφίσα προπώλησης: μαύρο φόντο, λευκά γράμματα «οἱ βλάξ», ένα πολύχρωμο σπιράλ γλειφιτζούρι στο κέντρο, «29 Δεκεμβρίου 2018, η προπώληση άρχισε».',
    caption: '«Η προπώληση άρχισε.» Λέει 29 Δεκεμβρίου. Το πάρτι έγινε στις 27. Δεν το κρύβουμε: τα στοιχεία διαφωνούν.',
    conflict: true,
  },
  {
    key: 'afisa-vol03-hires.jpg',
    vol: 'vol.03 «οι ντένεξ»',
    date: 'Πέμπτη 27 Δεκεμβρίου 2018',
    alt: 'Αφίσα ΒΛΑΞ vol.03: μαύρο φόντο, λευκή γραμματοσειρά Didot: «Ο ηλίθιος ντενεκές και ο μπατίρης ντενεκές. Χώρια δεν αντέχονται. Αλλά μαζί είναι: οι βλάξ». Δύο ντενεκέδες λαδιού με μπλε-χρυσό μοτίβο: μεγάλος + μικρός = μούρλια. Λογότυπο fuit art cafe σε κόκκινο πλαίσιο.',
    caption: '«Χώρια δεν αντέχονται.» + = μούρλια.',
  },
  {
    key: 'afisa-vol04-hires.jpg',
    vol: 'vol.04',
    date: 'Σάββατο 28 Δεκεμβρίου 2019, 18:00',
    alt: 'Αφίσα ΒΛΑΞ vol.04: γκρι φόντο, τεράστιος κόκκινος απαγορευτικός κύκλος πάνω στη φράση «οἱ βλάξ», και από κάτω τέσσερα απαγορευτικά εικονίδια: τσιγάρο, φεγγάρι με αστέρια, γλειφιτζούρι, αρκουδάκι.',
    caption: 'Απαγορεύονται: το κάπνισμα, ο ύπνος, τα γλειφιτζούρια, τα αρκουδάκια, οι βλάξ. Προσήλθαν όλοι.',
  },
  {
    key: 'afisa-vol04-parallagi.jpg',
    vol: 'vol.04, παραλλαγή',
    date: 'ίδια βραδιά, άλλη στοιχειοθεσία',
    alt: 'Παραλλαγή της αφίσας του vol.04: η ίδια σύνθεση με την ημερομηνία «28 Δεκεμβρίου 2019, 18:00» στην κορυφή αντί για κάτω από τον κύκλο.',
    caption: 'Η ημερομηνία πάνω αντί για κάτω. Σώζονται και οι δύο. Δεν ξέρουμε ποια κόλλησε στον τοίχο.',
  },
  {
    key: 'afisa-2021-asteia.jpg',
    vol: '2021, δεν έγινε',
    date: 'η αφίσα της ματαίωσης',
    alt: 'Γκρι αφίσα: «οἱ βλάξ» σε λευκά γράμματα, και από κάτω «Ο αρνητικός (πρώην μπατίρης) κι ο θετικός (πρώην ηλίθιος) βλαξ θα επιστρέψουν το 2022». Εικονίζονται δύο ραπίντ τεστ SARS-CoV-2: το ένα με μία γραμμή, το άλλο με δύο.',
    caption: '«Ο αρνητικός (πρώην μπατίρης) κι ο θετικός (πρώην ηλίθιος).» Νέα ονοματολογία, ίδια ανωνυμία. Δεν επέστρεψαν το 2022: το Fuit έκλεισε.',
  },
  {
    key: 'afisa-athina-2024.jpg',
    vol: 'Αθήνα 2024, γκεστ',
    date: 'Κυριακή 7 Ιουλίου 2024, 17:00',
    alt: 'Αφίσα «ATHENS vol.2, ΡΑΝΤΙΚΑΛ ΠΑΡΤΥ»: μωβ βανάκι με σανίδα σερφ μπροστά από την Ακρόπολη, πορτοκαλί ήλιος, «Live to get Radical», «ΓΚΕΣΤ DJ: ΟΙ ΒΛΑΞ, Stergios Chantzikyriakidis, Alexandros Chantzis», καφενείο «Η Αυλή», Κουκάκι.',
    caption: 'Πέντε χρόνια μετά το vol.04, ως προσκεκλημένοι σε ξένη γιορτή. Keep Koukaki Weird.',
  },
];
---
<Base title="Αφίσες  - ΒΛΑΞ" current="αφισες" palette="skyladiko"
  description="Οι αφίσες των τεσσάρων ΒΛΑΞ σε πλήρη ανάλυση. Και το κενό κάδρο του vol.02.">
  <div class="shell">
    <h1>ΑΦΙΣΕΣ</h1>
    <p class="book intro">
      Οκτώ αφίσες: τέσσερα vol., μία προπώληση που διαφωνεί με τον εαυτό της, μία παραλλαγή,
      η αφίσα μιας ματαίωσης, και μία αθηναϊκή πρόσκληση. Οι περισσότερες σε τυπογραφική
      ανάλυση, από τον φάκελο των ίδιων. Καμία περικοπή, καμία «επιμέλεια». Ό,τι κρεμάστηκε
      στον τοίχο του Fuit, κρεμιέται κι εδώ.<Fn n="8">
        Παρατήρηση στοιχειοθεσίας: οι πραγματικές αφίσες του 2018 και του 2019 είναι στημένες σε
        Didot πάνω σε μαύρο και γκρι. Η «τυπογραφημένη κακογουστιά» αυτού του ιστότοπου δεν είναι
        εύρημα, είναι αποκατάσταση. Ο αφηγητής είναι γλωσσολόγος. Οι αφίσες το ήξεραν πρώτες.
      </Fn>
    </p>

    <div class="posterwall halftone">
      {walls.map((p) => {
        const m = p.key ? media(p.key) : undefined;
        return (
          <figure class={m ? 'poster-item' : 'poster-item wanted'}>
            <h2>{p.vol}</h2>
            <p class="small muted">{p.date}</p>
            {m
              ? <>
                  <Pic m={m} alt={p.alt} sizes="(max-width: 44rem) 100vw, 40rem" caption={p.caption} />
                  {p.conflict && <p class="small"><a href={`${B}/διαφωνιες/`}>⚠ τα στοιχεία διαφωνούν →</a></p>}
                </>
              : (
                <div class="empty-frame">
                  <p class="book">ΖΗΤΕΙΤΑΙ</p>
                  <p class="book small">{p.caption}</p>
                  <a href={`${B}/κενα/`}>→ Κενά</a>
                </div>
              )}
          </figure>
        );
      })}
    </div>
  </div>
</Base>
<style>
  h1 { margin-top: 2rem; }
  .intro { max-width: 44rem; font-size: 1.1rem; }
  .posterwall {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 2.5rem;
    padding: 2rem 0 3rem;
  }
  .poster-item { margin: 0; }
  .poster-item h2 { margin-bottom: 0; }
  .poster-item :global(img) { width: 100%; border: 4px solid #241a12; box-shadow: 0 8px 30px rgb(0 0 0 / .6); }
  .poster-item :global(figcaption) { font-family: var(--f-note); font-size: .85rem; color: #b8a88e; padding-top: .5rem; }
  .empty-frame {
    border: 4px dashed var(--rule);
    min-height: 24rem;
    display: grid;
    place-content: center;
    text-align: center;
    gap: .5rem;
    padding: 1.5rem;
  }
  .empty-frame p:first-child { font-size: 2rem; color: var(--kokkino); margin: 0; }
</style>

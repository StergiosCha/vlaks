---
/**
 * A primary-source quote (usually a Facebook post). Renders ⟦…⟧ spans as visible
 * redaction bars. Ο κανόνας της μαύρης μπάρας (DESIGN.md §3). Nothing is silently
 * rewritten; redaction is always visible.
 */
import type { FbQuote } from '../data/fbPosts';
interface Props { q: FbQuote }
const { q } = Astro.props;
const parts = q.text.split(/(⟦[^⟧]*⟧)/g).filter(Boolean).map((p) =>
  p.startsWith('⟦')
    ? { redacted: true, text: p.slice(1, -1) }
    : { redacted: false, text: p }
);
---
<blockquote class="fbq">
  <p class="book">
    «{parts.map((p) =>
      p.redacted
        ? <span class="redacted" aria-label="λογοκριμένο">{p.text}</span>
        : p.text
    )}»
  </p>
  <footer class="small muted">{q.author}, {q.dateDisplay}{q.note && <span class="book"> , {q.note}</span>}</footer>
</blockquote>
<style>
  .fbq { margin: 1.4rem 0; padding-left: 1rem; border-left: 3px solid var(--accent-2); }
  .fbq p { font-size: 1.08rem; line-height: 1.7; margin: 0 0 .4rem; }
</style>
